 /* ---- per-instance state ------------------------------------------------- */
@@ -270,6 +270,17 @@ static void update_tempo(wrap_t *w) {
     }
 }
 
+/* the host transport (audio thread, before render): an engine's tempo-synced LFOs take ppq/tempo straight from
+ * VstTimeInfo instead of the "lfo_bpm" param; engines without a transport callback are untouched. */
+static void update_transport(wrap_t *w) {
+    if (!g_api->transport) return;
+    VstTimeInfo *ti = (VstTimeInfo *)w->master(&w->fx, audioMasterGetTime, 0, kVstTransportState | kVstBarPosValid | kVstTempoValid, 0, 0);
+    int playing = ti && (ti->flags & kVstTransportState) ? 1 : 0;
+    int ppq_valid = ti && (ti->flags & kVstBarPosValid) ? 1 : 0;
+    double tempo = ti && (ti->flags & kVstTempoValid) ? ti->tempo : 0.0;
+    g_api->transport(w->dsp, ppq_valid ? ti->ppqPos : 0.0, tempo, playing, ppq_valid);
+}
+
 /* accumulate=1 is VST2's legacy process(), which must ADD to the output buffers; hosts here call
  * processReplacing, but a NULL e->process would crash any host that tried the old call. */
 #if !SAMPLE_ACCURATE
@@ -330,6 +341,7 @@ static void render_events(wrap_t *w, float **out, int32_t n, int accumulate) {
 static void housekeeping(AEffect *e, int32_t n) {
     wrap_t *w = e->object;
     if (HAS_LFO_BPM) update_tempo(w);
+    update_transport(w);
     /* A trigger param (e.g. Generate) fired: tell the host it is back to 0 so
      * buttons bound to it drop their highlight. Done here, not inside
      * setParameter, so the host is not re-entered from its own call. */
